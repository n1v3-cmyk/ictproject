# ---------------------------------------------------------------------------
# CivicConnect backend environment variables
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL is the default).
# Preferred: a single URL.
# DATABASE_URL=postgres://civicconnect:password@localhost:5432/civicconnect
# ...or discrete variables:
DB_ENGINE=postgresql
DB_NAME=civicconnect
DB_USER=civicconnect
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Local development without a PostgreSQL server (do NOT use in production):
# DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3

# Where uploaded attachments are stored on disk.
MEDIA_ROOT=media

# Origins allowed to call the API (the Next.js dev server).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
